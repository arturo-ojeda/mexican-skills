# Dependencias instaladas (se regeneran con `npm install`)
node_modules/

# Outputs en runtime de las skills (PDFs, screenshots, state.json con PII).
# Las skills bajan archivos a $(pwd); estos patrones cubren los nombres
# canónicos para que no entren al repo si corres una skill desde la raíz.
Constancia*.pdf
constancia-*.pdf
Recibo*CFE*.pdf
recibo-cfe*.pdf
constancia-run-*/
constancia-live-capture-*/
sat-buzon-*/

# Logs y perfiles temporales de Chrome
*.log
sat-*-chrome-profile/
cfe-chrome-profile/

# Credenciales / secretos por si alguien los deja por accidente
.env
.env.*
!.env.example
*.secret
secrets.json

# macOS / editor
.DS_Store
.AppleDouble
.LSOverride
.idea/
.vscode/
*.swp
*~

# npm / yarn / pnpm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
