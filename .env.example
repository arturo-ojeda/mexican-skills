# Copia este archivo como .env y rellena SOLAMENTE los SECRETOS (passwords y
# API keys). Las skills NO leen .env automáticamente: defínelas en tu shell
# (e.g. ~/.zshrc) o expórtalas en la sesión actual.
#
#   export $(grep -v '^#' .env | xargs)        # bash/zsh
#   export $(cat .env | sed 's/^#.*//' | xargs) # alternativa
#
# Nunca commitees el .env real — el .gitignore ya lo excluye.
#
# REGLA DE ORO:
#   - Secretos (password, api key, token)  ──>  variable de entorno o shell rc.
#   - PII no-secreta (RFC, usuario CFE, nombre, CP, régimen, uso CFDI, email)
#     ──>  profile JSON local en
#         ${MEXICAN_SKILLS_PROFILE:-${XDG_CONFIG_HOME:-~/.config}/mexican-skills/profile.json}
#         con permisos 0600. Es un objeto JSON plano; edítalo con tu editor o
#         déjale al agente que lo escriba. Nunca metas secretos ahí.
#
# Las skills resuelven cada dato con la cadena env → shell rc → profile → preguntar.

# ── SAT (buzon-tributario, constancia-situacion-fiscal) ────────────────────
# SAT_RFC se puede definir aquí, pero también lo resuelve el profile (campo `rfc`).
# SAT_PASSWORD es secreto: ENV/shell ÚNICAMENTE.
SAT_RFC=
SAT_PASSWORD=

# ── CFE (recibo-cfe) ───────────────────────────────────────────────────────
# CFE_USERNAME (correo o RPU) también lo resuelve el profile (campo `cfeUsername`).
# CFE_PASSWORD es secreto: ENV/shell ÚNICAMENTE.
CFE_USERNAME=
CFE_PASSWORD=

# ── 2Captcha (skills SAT, opcional para CFE) ───────────────────────────────
# Secreto: ENV/shell ÚNICAMENTE.
# La variable canónica es TWOCAPTCHA_API_KEY.
# CAPTCHA_SOLVER_API_KEY queda como alias por compatibilidad.
TWOCAPTCHA_API_KEY=

# ── Profile (opcional) ─────────────────────────────────────────────────────
# Override del path del archivo de memoria. Útil para perfiles paralelos
# (e.g. tu RFC y el de tu mamá). Por default usa XDG.
# MEXICAN_SKILLS_PROFILE=/ruta/absoluta/preferida/profile.json

# ── Overrides opcionales ───────────────────────────────────────────────────
# CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# CHROME_BIN=/usr/bin/google-chrome
# SAT_CDP_PORT=18800
# Por default los outputs caen en $(pwd)/artifacts/ (carpeta donde corres el comando).
# Sólo override estas variables si necesitas otro destino.
# SAT_ARTIFACTS_DIR=/ruta/absoluta/preferida
# CFE_ARTIFACTS_DIR=/ruta/absoluta/preferida
# SAT_BUZON_ARTIFACTS_DIR=/ruta/absoluta/preferida
# SAT_PDF_NAME_PREFIX=Constancia
# CFE_PDF_NAME_PREFIX=Recibo CFE
