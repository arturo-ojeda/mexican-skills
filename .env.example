# Copia este archivo como .env y rellena los valores que uses. Las skills NO
# leen .env automáticamente: defínelas en tu shell (e.g. ~/.zshrc) o expórtalas
# en la sesión actual:
#
#   export $(grep -v '^#' .env | xargs)        # bash/zsh
#
# Nunca commitees el .env real — el .gitignore ya lo excluye.
#
# Las skills resuelven cada variable en este orden:
#   process.env  →  ~/.zshrc, ~/.zprofile, ~/.bashrc, ~/.bash_profile, ~/.profile
#
# Reglas:
#   - Secretos (passwords, API keys)  ──>  ENV o shell rc, NUNCA commiteado.
#   - PII no-secreta (RFC, CFE_USERNAME)  ──>  ENV o shell rc también.
#     Para uso personal, dejarlo en ~/.zshrc es lo más cómodo.

# ── SAT (buzon-tributario, constancia-situacion-fiscal) ────────────────────
SAT_RFC=
SAT_PASSWORD=

# ── CFE (recibo-cfe) ───────────────────────────────────────────────────────
CFE_USERNAME=
CFE_PASSWORD=

# ── Jalisco (pago-infracciones-jalisco) ────────────────────────────────────
# PII pero no secreta. Si consultas siempre el mismo vehículo, déjalas en
# ~/.zshrc; si no, pásalas por CLI args (--placa, --serie, etc.) al momento.
# Solo placa y número de serie son requeridos; propietario y motor son opcionales.
JALISCO_PLACA=
JALISCO_NUMERO_SERIE=
# JALISCO_PROPIETARIO=
# JALISCO_NUMERO_MOTOR=

# ── 2Captcha (skills SAT/CURP/Jalisco) ─────────────────────────────────────
# La variable canónica es TWOCAPTCHA_API_KEY.
# CAPTCHA_SOLVER_API_KEY queda como alias por compatibilidad.
TWOCAPTCHA_API_KEY=

# ── Overrides opcionales ───────────────────────────────────────────────────
# CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# CHROME_BIN=/usr/bin/google-chrome
# SAT_CDP_PORT=18800
# Por default los outputs caen directo en $(pwd) (carpeta donde corres el comando).
# Sólo override estas variables si necesitas otro destino.
# SAT_ARTIFACTS_DIR=/ruta/absoluta/preferida
# CFE_ARTIFACTS_DIR=/ruta/absoluta/preferida
# SAT_BUZON_ARTIFACTS_DIR=/ruta/absoluta/preferida
# JALISCO_INFRACCIONES_ARTIFACTS_DIR=/ruta/absoluta/preferida
# SAT_PDF_NAME_PREFIX=Constancia
# CFE_PDF_NAME_PREFIX=Recibo CFE
